<div class="kml-flash" role="status" aria-live="polite">
  <% {notice: ['success', '✓'], alert: ['danger', '!'], warning: ['warning', '!'], info: ['secondary', 'i']}.each do |key, (style, mark)| %>
    <% if message = flash[key].presence %>
      <div class="alert <%= 'alert-' + style %> alert-dismissible fade show">
        <span class="kml-flash__mark" aria-hidden="true">
          <%= mark %>
        </span>

        <span class="kml-flash__body">
          <%= message %>
        </span>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="閉じる"
        ></button>
      </div>
    <% end %>
  <% end %>
</div>
