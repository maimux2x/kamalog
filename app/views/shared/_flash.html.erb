<% {notice: 'alert-success', alert: 'alert-danger'}.each do |key, style| %>
  <% if message = flash[key].presence %>
    <div class="alert <%= style %> alert-dismissible fade show">
      <%= message %>

      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close"
      ></button>
    </div>
  <% end %>
<% end %>
