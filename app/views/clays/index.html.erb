<%= render 'breadcrumb', items: [
  [current_studio.name, studio_path(current_studio)],
  ['設定', studio_settings_path(current_studio)],
  '土'
] %>

<%= link_to '新規登録', new_studio_clay_path(current_studio), class: 'btn btn-outline-primary mb-3' %>
<%= link_to '一括登録', new_studio_clays_bulk_path(current_studio), class: 'btn btn-outline-primary mb-3' %>

<%= render 'sortable_list', **{
  resource_name: 'clay',
  records:       @clays,
  update_url:    ->(clay) { studio_clay_path(current_studio, clay) },
  name:          :name.to_proc
} do |clay| %>
  <%= link_to '編集', edit_studio_clay_path(current_studio, clay), class: 'btn btn-outline-primary' %>
  <%= button_to '削除', studio_clay_path(current_studio, clay), method: :delete, form: {data: {turbo_confirm: '本当に削除しますか？'}}, class: 'btn btn-danger' %>
<% end %>
