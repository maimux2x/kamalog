<%= render 'breadcrumb', items: [
  [current_studio.name, studio_path(current_studio)],
  ['設定', studio_settings_path(current_studio)],
  '土'
] %>

<%= link_to '新規登録', new_studio_clay_path(current_studio), class: 'btn btn-outline-primary mb-3' %>
<%= link_to '一括登録', new_studio_clays_bulk_path(current_studio), class: 'btn btn-outline-primary mb-3' %>

<ul class="list-group" data-controller="sortable" data-sortable-resource-name-value="clay">
  <% @clays.each do |clay| %>
    <li class="d-flex list-group-item align-items-center gap-2" data-sortable-update-url="<%= studio_clay_path(current_studio, clay) %>">
      <span class="me-auto">
        <span class="handle">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16" style="cursor: grab;">
            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
          </svg>
        </span>
        <%= clay.name %>
      </span>
      <%= link_to '編集', edit_studio_clay_path(current_studio, clay), class: 'btn btn-outline-primary' %>
      <%= button_to '削除', studio_clay_path(current_studio, clay), method: :delete, form: {data: {turbo_confirm: '本当に削除しますか？'}}, class: 'btn btn-danger' %>
    </li>
  <% end %>
</ul>
