<div class="hstack gap-2">
  <h1><%= piece.title %></h1>
  <% if piece.complete? %>
    <time datetime="<%= piece.completed_at.iso8601 %>"><%= l piece.completed_at.to_date %></time>
  <% end %>
</div>

<ul class="nav nav-tabs mb-3">
  <li class="nav-item">
    <%= link_to '作品詳細', studio_my_piece_path(studio, piece), class: ['nav-link', active: current_page?(studio_my_piece_path(studio, piece))] %>
  </li>

  <li class="nav-item">
    <%= link_to studio_my_piece_logs_path(studio, piece), class: [
      'nav-link',
      'd-flex',
      'align-items-center',
      active: current_page?(studio_my_piece_logs_path(studio, piece))
    ] do %>
      作業記録
      <span class="ms-2 badge text-bg-secondary"><%= piece.logs.size %></span>
    <% end %>
  </li>
</ul>
