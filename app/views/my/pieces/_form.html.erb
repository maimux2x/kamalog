<%= form_with model: [studio, :my, piece], class: 'kml-form kml-form--card' do |f| %>
  <%= link_to '自分の作品', studio_my_pieces_path(current_studio), class: 'kml-back kml-form__back' %>

  <div class="kml-form__card">
    <div class="kml-form__head">
      <h1 class="kml-form__title">作品を登録</h1>
    </div>

    <div class="kml-form__body kml-piece-form">
      <div class="kml-piece-form__name">
        <%= f.label '作品名', class: 'form-label', for: 'piece_name' %>
        <%= f.text_field :title, class: 'form-control', id: 'piece_name' %>
      </div>

      <div class="kml-piece-form__method">
        <%= f.label '成形方法', class: 'form-label', for: 'piece_method' %>
        <%= f.collection_select :form_method, Piece.form_methods_i18n, :first, :last, {prompt: true}, class: 'form-select', id: 'piece_method' %>
      </div>

      <fieldset
        class="kml-piece-form__clays"
        data-controller="nested-form"
        data-nested-form-min-items-value="1"
      >
        <legend class="form-label">土の種類と使用量</legend>

        <div data-nested-form-target="container">
          <%= f.fields_for :clay_usages, include_id: false do |clay_usage| %>
            <%= render 'clay_usage', form: clay_usage %>
          <% end %>
        </div>

        <button
          type="button"
          class="kml-add-btn"
          data-action="click->nested-form#add"
        >
          ＋ 土を追加
        </button>

        <template data-nested-form-target="template">
          <%= f.fields_for :clay_usages, piece.clay_usages.new, child_index: '__INDEX__' do |clay_usage| %>
            <%= render 'clay_usage', form: clay_usage %>
          <% end %>
        </template>
      </fieldset>

      <fieldset class="kml-piece-form__glazes" data-controller="nested-form">
        <legend class="form-label">釉薬の種類</legend>
        <p class="form-text mt-0">釉掛けの作業記録からでも登録できます。</p>

        <div data-nested-form-target="container">
          <%= f.fields_for :glaze_usages, include_id: false do |glaze_usage| %>
            <%= render 'glaze_usage', form: glaze_usage %>
          <% end %>
        </div>

        <button
          type="button"
          class="kml-add-btn"
          data-action="click->nested-form#add"
        >
          ＋ 釉薬を追加
        </button>

        <template data-nested-form-target="template">
          <%= f.fields_for :glaze_usages, piece.glaze_usages.new, child_index: '__INDEX__' do |glaze_usage| %>
            <%= render 'glaze_usage', form: glaze_usage %>
          <% end %>
        </template>
      </fieldset>

      <div class="kml-switch-row kml-piece-form__done">
        <div class="kml-switch-row__body">
          <span class="kml-switch-row__label">もう完成している</span>
          <span class="kml-switch-row__note">代表画像とコメントを設定できます</span>
        </div>

        <div class="form-check form-switch m-0">
          <%= f.checkbox :status, id: 'piece_complete', name: 'piece[complete]', class: 'form-check-input' %>
          <%= f.label 'もう完成している', class: 'visually-hidden', for: 'piece_complete' %>
        </div>
      </div>
    </div>

    <footer class="kml-form__foot">
      <%= link_to 'キャンセル', piece.persisted? ? studio_my_piece_path(studio, piece) : studio_my_pieces_path(studio), class: 'btn btn-outline-secondary kml-form__foot-cancel' %>
      <%= f.submit class: 'btn btn-primary' %>
    </footer>
  </div>
<% end %>
