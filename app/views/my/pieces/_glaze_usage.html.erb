<div class="kml-material-row" data-nested-form-target="item">
  <% if form.object.persisted? %>
    <%= form.hidden_field :id %>
  <% end %>

  <%= form.label :glaze_id, class: 'visually-hidden' %>
  <%= form.collection_select :glaze_id, current_studio.glazes.order(:created_at), :id, :name, {prompt: true, required: true}, class: 'form-select form-select-sm' %>

  <div class="kml-material-row__amount">
    <button
      type="button"
      class="kml-remove-btn"
      data-nested-form-target="removeButton"
      data-action="click->nested-form#remove"
    >
      削除
    </button>
  </div>
</div>
