<div class="kml-sortable__row" data-attach-images-target="item">
  <span class="kml-sortable__handle" aria-hidden="true">⣿</span>
  <% if photo.object.persisted? %>
    <%= image_tag photo.object.file, height: 100, alt: '' %>
    <%= photo.hidden_field :id %>
  <% else %>
    <%= image_tag '', height: 100, alt: '', class: 'kml-sortable__thumb kml-photo-empty' %>
    <%= photo.label :file, hidden:true %>
    <%= photo.file_field :file, hidden: true %>
  <% end %>

  <%= photo.hidden_field :position, data: {sortable_positioning_target: 'position'} %>

  <%= photo.label :caption, '説明', class: 'visually-hidden' %>
  <%= photo.text_field :caption, class: 'kml-sortable__caption' %>

  <button
    class="kml-sortable__remove"
    aria-label="削除"
    type="button"
    data-action="attach-images#remove"
  >削除</button>
</div>
